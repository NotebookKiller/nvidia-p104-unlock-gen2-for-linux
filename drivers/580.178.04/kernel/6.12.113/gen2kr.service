[Unit]
Description=NVIDIA PCIe Gen2 push (P104-100 / Pascal)
# Must run after the nvidia driver is loaded. gen2kr depends on the module-local symbol nv_pci_probe.
After=nvidia.service systemd-modules-load.service
Wants=nvidia.service
# Do not retry endlessly while nvidia has not come up
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Type=oneshot
RemainAfterExit=yes

# ★ Ordering matters (reports/184 iron rule #4):
#   1. nvidia must load first (otherwise kallsyms has no nv_pci_probe and register_kretprobe returns -2)
#   2. insmod gen2kr -- it attaches a kretprobe on nv_pci_probe and pre-maps BAR0
#   3. unbind/bind triggers one probe; the push fires the instant the probe returns
#
# ★ guard_rounds=0 (default) keeps the guard resident as a safety net.
#   With the patch (patch_no_gen1.py) in place the guard should be a no-op;
#   if the patch is lost (after a driver upgrade), the guard can still pull
#   the link back up -- a double safety net.

ExecStartPre=/sbin/modprobe nvidia
ExecStartPre=/sbin/modprobe nvidia_uvm
ExecStartPre=/bin/sh -c 'lsmod | grep -q "^gen2kr" && /sbin/rmmod gen2kr || true'
ExecStart=/sbin/insmod /data/labs/nvidia/nvidia-p104-unlock-gen2-for-linux/build/gen2kr.ko
ExecStart=/bin/sh -c 'echo 0000:01:00.0 > /sys/bus/pci/drivers/nvidia/unbind; sleep 1; echo 0000:01:00.0 > /sys/bus/pci/drivers/nvidia/bind'

# Post-start self-check: LNKSTA should be 2. Log only, never fail (avoid stalling boot)
ExecStartPost=/bin/sh -c '/data/labs/nvidia/nvidia-p104-unlock-gen2-for-linux/bin/peek-regs.py || true'

ExecStop=/sbin/rmmod gen2kr

[Install]
WantedBy=multi-user.target
